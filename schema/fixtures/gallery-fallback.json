  "root" : {
    "type" : "column",
    "id" : "root",
    "props" : {
      "spacing" : 20
    },
    "children" : [ {
      "type" : "column",
      "id" : "header",
      "props" : {
        "spacing" : 4
      },
      "children" : [ {
        "type" : "text",
        "id" : "heading",
        "props" : {
          "text" : "My keepsakes",
          "style" : "title"
        }
      }, {
        "type" : "text",
        "id" : "subheading",
        "props" : {
          "text" : "{{count}} things worth keeping",
          "style" : "caption"
        }
      } ]
    }, {
      "type" : "list",
      "id" : "items",
      "props" : {
        "itemsBinding" : "items"
      },
      "template" : {
        "type" : "column",
        "id" : "item-card",
        "props" : {
          "spacing" : 4
        },
        "children" : [ {
          "type" : "image",
          "id" : "item-card-image",
          "props" : {
            "url" : "{{item.imageUrl}}",
            "alt" : "{{item.title}}",
            "aspectRatio" : 1.0
          }
        }, {
          "type" : "text",
          "id" : "item-card-title",
          "props" : {
            "text" : "{{item.title}}",
            "style" : "headline"
          }
        }, {
          "type" : "text",
          "id" : "item-card-subtitle",
          "props" : {
            "text" : "{{item.year}}",
            "style" : "caption"
          }
        } ],
        "action" : {
          "type" : "navigate",
          "screenId" : "item-detail",
          "params" : {
            "itemId" : "{{item.id}}"
          }
        }
      }
    } ]
  }
}
